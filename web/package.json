{
	"name": "vinx-web-app",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "The page: agent-core's chat UI over the wasm engine, no server",
	"scripts": {
		"dev": "npm run build:skill && vite",
		"dev:https": "npm run build:skill && HTTPS_DEV=1 vite --host",
		"build": "npm run build:wasm && npm run build:skill && vite build",
		"build:wasm": "cd runtime && npm run build:wasm",
		"build:skill": "node build-skill.mjs",
		"preview": "vite preview"
	},
	"dependencies": {
		"@noble/ciphers": "^2.3.0",
		"@noble/curves": "^2.3.0",
		"@noble/hashes": "^2.3.0",
		"@xterm/addon-clipboard": "^0.2.0",
		"@xterm/addon-fit": "^0.10.0",
		"@xterm/addon-image": "^0.9.0",
		"@xterm/addon-unicode11": "^0.9.0",
		"@xterm/addon-web-links": "^0.12.0",
		"@xterm/xterm": "^5.5.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"v86": "^0.5.432"
	},
	"devDependencies": {
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"@vitejs/plugin-react": "^4.3.4",
		"playwright": "^1.62.1",
		"typescript": "^5.9.3",
		"vite": "^7.0.4",
		"ws": "^8.21.3"
	}
}
