# Credentials for the opt-in live-provider test (crates/agent-web-core/tests/live.rs).
#
# Copy to `.env.live`, fill in, then:
#
#     ./deploy/live.sh
#
# `.env.live` is gitignored. Keep it that way: this file is the one that is
# committed, and it must never hold a real key.

LIVE_BASE_URL=https://api.deepseek.com/v1
LIVE_API_KEY=sk-...
LIVE_MODEL=deepseek-v4-pro
