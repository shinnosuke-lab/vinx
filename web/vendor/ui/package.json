{
  "name": "@vinx/agent-chat",
  "version": "0.1.0",
  "description": "Reusable React chat UI for agent-core: SSE streaming, tool-call rendering, confirm/ask flows, session history. Source-distributed and customizable.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./src/*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "build:app": "vite build -c vite.app.config.ts",
    "dev:app": "vite -c vite.app.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-separator": "^1",
    "@radix-ui/react-slot": "^1",
    "@radix-ui/react-tooltip": "^1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "dompurify": "^3",
    "highlight.js": "^11",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.468.0",
    "react-devicons": "^2.16.2",
    "react-markdown": "^9",
    "rehype-highlight": "^7",
    "remark-gfm": "^4",
    "tailwind-merge": "^3"
  },
  "optionalDependencies": {
    "mermaid": "^11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "mermaid": "^11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4",
    "typescript": "~5.6.2",
    "vite": "^6",
    "vite-plugin-dts": "^4"
  }
}
