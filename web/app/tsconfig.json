{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["vite/client"],
		"baseUrl": "..",
		"paths": {
			"@vinx/agent-chat": ["vendor/ui/dist/index"]
		}
	},
	"include": ["."],
	"exclude": ["test", "public", "gen"]
}
