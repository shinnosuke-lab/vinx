#!/bin/sh
# notify MESSAGE... -- a browser notification, for when a long job finishes.
#
# One control-plane call (notify.show, via rpc(1) on ttyS3): the page shows
# a system notification where permission is granted and falls back to its
# corner toast otherwise. Works from the console and from run_shell alike;
# with no page attached the error names the problem instead of dropping the
# words (system-v2 §15 Phase 3: no silent no-op).

[ $# -ge 1 ] || { echo 'usage: notify MESSAGE...' >&2; exit 2; }

jq -cn --arg text "$*" '{text: $text}' | rpc call notify.show - >/dev/null
