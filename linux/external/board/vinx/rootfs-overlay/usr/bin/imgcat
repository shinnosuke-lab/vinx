#!/bin/sh
# imgcat [-w WIDTH] FILE... -- show images inline, right here in the terminal.
#
# iTerm2's inline image protocol (OSC 1337, inline=1); the page's
# @xterm/addon-image decodes and draws, so nothing in this machine needs to
# understand PNG. Without -w the addon auto-fits: small images at their own
# pixels, big ones scaled down to fill the viewport whole. -w pins a width --
# cells (60), viewport share (50%), or pixels (800px, i.e. 1:1) -- height
# follows the aspect ratio. The terminal cannot scroll sideways, so a width
# past the screen edge is clipped on the spot; for a real look at a big
# image, open(1) it. Siblings: download(1) saves to the person's machine.
. /usr/lib/vinx.sh

usage() { echo 'usage: imgcat [-w CELLS|N%|Npx] FILE...' >&2; exit 2; }

width=auto
if [ "${1:-}" = -w ]; then
	[ -n "${2:-}" ] || usage
	width=$2
	shift 2
fi
case "$width" in
	auto) opt='' ;;
	*)
		case "$width" in
			*%) _n=${width%\%} ;;
			*px) _n=${width%px} ;;
			*) _n=$width ;;
		esac
		case "$_n" in
			'' | *[!0-9]*) usage ;;
		esac
		opt=";width=$width"
		;;
esac

[ $# -ge 1 ] || usage

rc=0
for f in "$@"; do
	vm_file_ok imgcat "$f" || { rc=1; continue; }
	printf '\033]1337;File=name=%s;size=%s;inline=1%s:%s\a\n' \
		"$(vm_b64s "$(basename "$f")")" "$(wc -c < "$f")" "$opt" "$(vm_b64 "$f")"
done
exit $rc
