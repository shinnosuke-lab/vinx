#!/bin/sh
# js -- run JavaScript on the page hosting this machine, not in it.
#
# The code executes on the browser's main thread with the page's own powers:
# `await` works, `document` and `window` are the page's, `fetch` is the
# browser's (CORS applies). Console output and the completion value come back
# here; expression results count (`js -e '6*7'` prints 42). qjs(1) is the
# in-guest JavaScript; this one is for when you need the *browser*.
#
# Rides the hostcall channel on /dev/ttyS3 (see /usr/lib/hostcall.sh), which
# works the same from the console and from the agent's run_shell. One warning
# is structural: the timeout can only interrupt code that awaits -- a
# synchronous infinite loop freezes the page itself, so do not write one.

. /usr/lib/hostcall.sh

usage() {
	cat >&2 <<'EOF'
usage: js FILE          run a script file on the hosting page
       js -e CODE       run an inline expression or script
       ... | js         run what stdin carries
       -t SECS          give an awaiting script this long (default 30, max 120)

The code runs in the BROWSER PAGE (DOM, page fetch, CORS), not in this Linux.
The result is the script's console output plus its completion value.
EOF
	exit 2
}

tmo=30
code=
have_code=
while [ $# -gt 0 ]; do
	case "$1" in
		-e) [ $# -ge 2 ] || usage; code=$2; have_code=1; shift 2 ;;
		-t) [ $# -ge 2 ] || usage; tmo=$2; shift 2 ;;
		-h|--help) usage ;;
		-*) usage ;;
		*)
			[ -n "$have_code" ] && usage
			[ -f "$1" ] || { echo "js: $1: no such file" >&2; exit 1; }
			code=$(cat "$1"); have_code=1; shift ;;
	esac
done
if [ -z "$have_code" ]; then
	[ -t 0 ] && usage
	code=$(cat)
fi
case "$tmo" in ''|*[!0-9]*) tmo=30 ;; esac
[ "$tmo" -gt 120 ] && tmo=120
[ "$tmo" -lt 1 ] && tmo=1

payload=$(jq -cn --arg code "$code" --argjson t $((tmo * 1000)) '{code: $code, timeoutMs: $t}')
reply=$(hostcall js "$payload" "$tmo") || exit 1

hostcall_body "$reply"
# The body rarely ends in a newline of its own; give the shell prompt one.
echo
err=$(printf '%s' "$reply" | jq -r '.error // empty')
[ -n "$err" ] && echo "js: $err" >&2
[ "$(printf '%s' "$reply" | jq -r '.ok')" = "true" ]
