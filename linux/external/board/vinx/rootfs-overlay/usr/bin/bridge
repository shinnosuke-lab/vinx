#!/bin/sh
# bridge -- one LAN across browsers: drive the page's WebRTC room from here.
#
# `start` mints a six-character room code (the page publishes sealed SDP
# under it through public Nostr relays -- nobody runs a server); `join`
# takes a code a friend read to you. Either way the machines share one
# ethernet segment: ping, nc, httpd across the internet -- and `say`,
# whose words float across every bridged screen as an overlay: nothing
# needs to be running on the receiving machines.
#
# Commands are network.bridge.* control-plane calls (rpc(1) on ttyS3):
# start/join block until the room is on, show reads the live roster -- a
# room the person opened with panel clicks answers here too. They work
# from the console and from run_shell alike, and a failure is an error
# you hear, not a poll that times out.

usage() {
	cat >&2 <<'EOF'
usage: bridge start [-n NAME]      host a room, print its code
       bridge join CODE [-n NAME]  join a friend's room
       bridge say [@NAME] WORDS    float a message on every screen (@NAME: just one)
       bridge show                 who is on the bridge
       bridge stop                 disconnect
EOF
	exit 2
}

self_host() { cat /run/inbrowser-host 2>/dev/null; }
self_ip() { echo "10.0.2.$(self_host)"; }

# NAME goes into the roster everyone sees: one word, safe charset.
check_name() {
	case "$1" in
	'' | *[!a-zA-Z0-9._-]* )
		echo 'bridge: NAME must be letters, digits, . _ -' >&2
		exit 2
		;;
	esac
}

# The live room, as the page answers it; show() renders one snapshot.
show() {
	res=$(rpc call network.bridge.status '{}') || return 1
	case "$(printf '%s' "$res" | jq -r '.state')" in
	on) ;;
	joining)
		echo 'bridge: still connecting...'
		return 0
		;;
	failed)
		echo "bridge: failed -- $(printf '%s' "$res" | jq -r '.error')" >&2
		return 1
		;;
	*)
		echo 'bridge: not connected (bridge start, or bridge join CODE)'
		return 1
		;;
	esac
	echo "bridge: room $(printf '%s' "$res" | jq -r '.room') ($(printf '%s' "$res" | jq -r '.role')) -- $(printf '%s' "$res" | jq -r '.members | length') machine(s)"
	me=$(self_ip)
	printf '%s' "$res" |
		jq -r '.members[] | "\(.name) \(.ip)\(if .host then " host" else "" end)"' |
		while read -r name ip tag; do
			mark=' '
			[ "$ip" = "$me" ] && mark='*'
			printf '  %s %-16s %-15s %s\n' "$mark" "$name" "$ip" "$tag"
		done
	echo "  (* this machine -- bridge say HELLO floats on every screen)"
}

cmd=$1
[ $# -ge 1 ] && shift

case "$cmd" in
start)
	name="vinx$(self_host)"
	[ "${1:-}" = -n ] && { name=${2:?bridge: -n needs a NAME}; shift 2; }
	[ $# -eq 0 ] || usage
	check_name "$name"
	echo 'bridge: opening a room...'
	res=$(jq -cn --arg name "$name" --arg ip "$(self_ip)" '{name: $name, ip: $ip}' |
		rpc call network.bridge.start - -t 30) || exit 1
	room=$(printf '%s' "$res" | jq -r '.room')
	echo ''
	echo "bridge: the room is open. friends join it with:"
	echo ''
	echo "    bridge join $room"
	echo ''
	echo 'bridge: chat with `bridge say HELLO` -- it floats on every screen'
	;;
join)
	[ $# -ge 1 ] || usage
	code=$1
	shift
	name="vinx$(self_host)"
	[ "${1:-}" = -n ] && { name=${2:?bridge: -n needs a NAME}; shift 2; }
	[ $# -eq 0 ] || usage
	check_name "$name"
	case "$code" in
	*[!a-zA-Z0-9]*)
		echo 'bridge: a room code is six letters and digits' >&2
		exit 2
		;;
	esac
	echo "bridge: joining room $code (this can take a few seconds)..."
	jq -cn --arg code "$code" --arg name "$name" --arg ip "$(self_ip)" \
		'{code: $code, name: $name, ip: $ip}' |
		rpc call network.bridge.join - -t 50 >/dev/null || exit 1
	# The frame channel can open a beat before the roster arrives; give the
	# member list a moment to fill in so the first show is not just us.
	i=0
	while [ "$i" -lt 5 ]; do
		m=$(rpc call network.bridge.status '{}' 2>/dev/null | jq -r '.members | length')
		[ "${m:-1}" -ge 2 ] 2>/dev/null && break
		sleep 1
		i=$((i + 1))
	done
	show
	;;
show)
	show
	;;
say)
	[ $# -ge 1 ] || usage
	to=''
	case "$1" in
	@?*)
		to=${1#@}
		shift
		check_name "$to"
		[ $# -ge 1 ] || usage
		;;
	esac
	# One clean line: control characters out, length capped so a paste
	# cannot flood the room (jq handles the JSON escaping).
	text=$(printf '%s' "$*" | tr -d '\000-\037' | cut -c1-256)
	[ -n "$text" ] || usage
	if [ -n "$to" ]; then
		jq -cn --arg text "$text" --arg to "$to" '{text: $text, to: $to}' |
			rpc call network.bridge.say - >/dev/null || exit 1
	else
		jq -cn --arg text "$text" '{text: $text}' |
			rpc call network.bridge.say - >/dev/null || exit 1
	fi
	echo 'bridge: sent'
	;;
stop)
	rpc call network.bridge.stop '{}' >/dev/null && echo 'bridge: disconnected'
	;;
*)
	usage
	;;
esac
