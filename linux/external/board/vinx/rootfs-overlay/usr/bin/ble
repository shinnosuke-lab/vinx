#!/bin/sh
# ble -- Web Bluetooth from the shell: the page speaks GATT, this end types.
#
# The browser exposes BLE at the GATT level only (no HCI), so this is a
# command bridge, not an adapter: connect to one device, list its services,
# read, write, subscribe. The device picker needs a human click -- `connect`
# parks a request on the footer's ble chip and blocks until the click picks
# a device (or the picker is dismissed); a device Chrome already remembers
# reconnects silently. Pairing has no API at all: a protected read/write
# makes the OS pop its own dialog, and the operation then simply succeeds --
# unpairing lives in the system's Bluetooth settings.
#
# Commands are ble.* control-plane calls (rpc(1) on ttyS3), answered as
# results and honest errors -- they work from the console and from run_shell
# alike. The one file left is the notification/scan feed: genuinely a
# stream, kept as an explicit ring the methods name in their results
# (system-v2 §6.8), which `ble watch` tails.

FEED=/data/.vinx/tmp/ble-feed

usage() {
	cat >&2 <<'EOF'
usage: ble scan [SECONDS]        advertisements, rolling (needs a chrome flag)
       ble connect [SERVICE]     pick a device -- the picker window is the scanner
       ble show                  the device and its connection
       ble services              GATT services and characteristics
       ble read SVC CHR          one value, hex
       ble write SVC CHR HEX     write bytes
       ble notify SVC CHR [off]  subscribe; values roll in `ble watch`
       ble watch                 follow subscribed values (ctrl-c stops)
       ble disconnect            let the device go
SVC/CHR: a full UUID, a 16-bit short like 180d, or a GATT name like heart_rate.
Pairing is the OS's business: a protected read/write pops its dialog by itself.
EOF
	exit 2
}

# UUIDs, GATT names and 16-bit shorts share one safe charset; refusing the
# rest keeps the errors early and readable.
check_word() {
	case "$1" in
	'' | *[!a-zA-Z0-9._-]*)
		echo "ble: $2 must be a UUID (180d, 00002a37-...) or a GATT name (heart_rate)" >&2
		exit 2
		;;
	esac
}

# Print feed lines as they appear: each is "N text", N ever-increasing, so
# the ring can be tailed across rewrites. $1 caps the run in seconds; empty
# runs until ctrl-c.
watch_feed() {
	deadline=$1
	last=$(tail -n 1 "$FEED" 2>/dev/null | cut -d' ' -f1)
	last=${last:-0}
	t=0
	while :; do
		if [ -f "$FEED" ]; then
			while read -r n rest; do
				[ "${n:-0}" -gt "$last" ] 2>/dev/null || continue
				last=$n
				echo "$rest"
			done <"$FEED"
		fi
		sleep 1
		t=$((t + 1))
		[ -n "$deadline" ] && [ "$t" -ge "$deadline" ] && break
	done
}

stop_scan() { rpc call ble.scan '{"on":false}' >/dev/null 2>&1; }

cmd=$1
[ $# -ge 1 ] && shift

case "$cmd" in
scan)
	secs=${1:-15}
	[ $# -le 1 ] || usage
	case "$secs" in '' | *[!0-9]*) usage ;; esac
	# The feed ring stays: the page rewrites it whole on every push, so
	# deleting it here would only reset watch_feed's baseline and replay old
	# notification lines as "scan results". The trap is set before anything
	# is asked, or a ctrl-c during the wait would leave the scan request
	# parked on the chip forever.
	trap 'stop_scan; exit 0' INT
	res=$(rpc call ble.scan '{"on":true}') || exit 1
	note=$(printf '%s' "$res" | jq -r '.note // empty')
	[ -n "$note" ] && echo "ble: $note"
	echo "ble: scanning for ${secs}s -- ctrl-c stops early"
	watch_feed "$secs"
	stop_scan
	;;
connect)
	[ $# -le 1 ] || usage
	svc=${1:-}
	[ -n "$svc" ] && check_word "$svc" SERVICE
	# The call blocks until a device is adopted: silently for one Chrome
	# remembers, otherwise until the person clicks the pulsing ble chip
	# (the page toasts that hint the moment the picker parks).
	echo 'ble: asking the page for a device (a parked picker pulses the ble chip)...'
	if [ -n "$svc" ]; then
		res=$(jq -cn --arg service "$svc" '{service: $service}' | rpc call ble.connect - -t 120) || exit 1
	else
		res=$(rpc call ble.connect '{}' -t 120) || exit 1
	fi
	echo "ble: connected to $(printf '%s' "$res" | jq -r '.device')"
	;;
show)
	res=$(rpc call ble.status '{}') || exit 1
	case "$(printf '%s' "$res" | jq -r '.state')" in
	connected) echo "ble: connected -- $(printf '%s' "$res" | jq -r '.device')" ;;
	pending) echo 'ble: waiting for the footer chip click' ;;
	*)
		echo 'ble: no device (ble connect)'
		exit 1
		;;
	esac
	;;
services)
	[ $# -eq 0 ] || usage
	res=$(rpc call ble.services '{}' -t 20) || exit 1
	ref=$(printf '%s' "$res" | jq -r '.servicesRef.path // empty')
	if [ -n "$ref" ]; then
		cat "$ref"
		rm -f "$ref"
	else
		printf '%s' "$res" | jq -rj '.services // empty'
		echo
	fi
	;;
read)
	[ $# -eq 2 ] || usage
	check_word "$1" SVC
	check_word "$2" CHR
	res=$(jq -cn --arg svc "$1" --arg chr "$2" '{svc: $svc, chr: $chr}' | rpc call ble.read - -t 20) || exit 1
	printf '%s\n' "$(printf '%s' "$res" | jq -r '.value')"
	;;
write)
	[ $# -eq 3 ] || usage
	check_word "$1" SVC
	check_word "$2" CHR
	hex=$3
	case "$hex" in '' | *[!0-9a-fA-F]*) usage ;; esac
	[ $((${#hex} % 2)) -eq 0 ] || usage
	if [ "${#hex}" -gt 1024 ]; then
		echo "ble: HEX is longer than 512 bytes (GATT's per-write cap)" >&2
		exit 2
	fi
	jq -cn --arg svc "$1" --arg chr "$2" --arg hex "$hex" '{svc: $svc, chr: $chr, hex: $hex}' |
		rpc call ble.write - -t 20 >/dev/null &&
		echo 'ble: written'
	;;
notify)
	[ $# -eq 2 ] || { [ $# -eq 3 ] && [ "$3" = off ]; } || usage
	check_word "$1" SVC
	check_word "$2" CHR
	if [ "${3:-}" = off ]; then
		jq -cn --arg svc "$1" --arg chr "$2" '{svc: $svc, chr: $chr, off: true}' |
			rpc call ble.notify - -t 20 >/dev/null &&
			echo 'ble: unsubscribed'
	else
		res=$(jq -cn --arg svc "$1" --arg chr "$2" '{svc: $svc, chr: $chr}' | rpc call ble.notify - -t 20) || exit 1
		note=$(printf '%s' "$res" | jq -r '.note // empty')
		[ -n "$note" ] && echo "ble: $note"
		echo 'ble: subscribed -- ble watch shows the values'
	fi
	;;
watch)
	[ $# -eq 0 ] || usage
	echo 'ble: watching -- ctrl-c stops the watch (ble notify SVC CHR off unsubscribes)'
	trap 'exit 0' INT
	watch_feed ''
	;;
disconnect)
	[ $# -eq 0 ] || usage
	rpc call ble.disconnect '{}' >/dev/null && echo 'ble: disconnected'
	;;
*)
	usage
	;;
esac
