#!/bin/sh
# say TEXT... -- macOS-style: the browser speaks it (speechSynthesis).
#
# One control-plane call (speech.speak, via rpc(1) on ttyS3); no permission
# prompt, the voice is whatever the browser's default is. Works from the
# console and from run_shell alike.

[ $# -ge 1 ] || { echo 'usage: say TEXT...' >&2; exit 2; }

jq -cn --arg text "$*" '{text: $text}' | rpc call speech.speak - >/dev/null
