#!/bin/sh
# lvdemo -- prove the GUI link: compile the shipped LVGL example with tcc,
# in the machine, and run it on the VGA screen (the footer's screen chip).
#
# The source is /usr/share/lvgl/lvdemo.c -- copy it anywhere as a starting
# point; `tcc yours.c -o app -llvgl` is the whole build. Ctrl-C quits.

set -e
src=/usr/share/lvgl/lvdemo.c
bin=/tmp/.lvdemo

# Pop the page's screen window: drawing on fb0 changes no video mode, so
# the page cannot notice by itself. window.focus is the desktop's window
# method (system-v2 §10.7). Best-effort -- rpc(1) needs the control plane,
# and an already-open window is a no-op.
rpc call window.focus '{"id":"screen"}' >/dev/null 2>&1 || true

if [ ! -x "$bin" ] || [ "$src" -nt "$bin" ]; then
	tcc "$src" -o "$bin" -llvgl
fi
# Compile outside the lock (seconds of tcc must not hold the screen),
# run inside it: one FB program at a time, stty given back on any exit.
exec fb-run "$bin" "$@"
