#!/bin/sh
# open FILE|URL -- macOS-style: hand it to the browser and let it decide.
#
# A URL goes out as window.openUrl. A file is staged into the session tmp
# namespace and handed over as a resource.open ref (system-v2 §6.8) -- the
# page gives it a MIME type from the extension and window.open()s a blob
# URL, so PDFs, HTML, images, video and text render in a new tab and
# anything else becomes a download under its own name. A popup blocker's
# veto parks the open on the footer chip, and the answer says so.
# Siblings: imgcat(1), download(1).
. /usr/lib/vinx.sh

[ $# -eq 1 ] || { echo 'usage: open FILE|URL' >&2; exit 2; }

case "$1" in
	http://* | https://*)
		res=$(jq -cn --arg url "$1" '{url: $url}' | rpc call window.openUrl - -t 30) || exit 1
		if [ "$(printf '%s' "$res" | jq -r '.disposition')" = parked ]; then
			echo 'open: the popup blocker stopped it -- click the open chip in the footer'
		fi
		exit 0
		;;
esac

vm_file_ok open "$1" || exit 1
grep -q ' /data 9p ' /proc/mounts || {
	echo 'open: no /data mount to stage through (this boot has no data plane)' >&2
	exit 1
}
REF="/data/.vinx/tmp/open-$$-$(date +%s).bin"
cp -- "$1" "$REF" || exit 1
res=$(jq -cn --arg name "$(basename "$1")" --arg path "$REF" \
	--argjson size "$(wc -c < "$REF")" \
	'{name: $name, ref: {path: $path, size: $size}}' |
	rpc call resource.open - -t 30)
rc=$?
rm -f "$REF"
[ "$rc" -eq 0 ] || exit 1
if [ "$(printf '%s' "$res" | jq -r '.disposition')" = parked ]; then
	echo 'open: the popup blocker stopped it -- click the open chip in the footer'
else
	echo "open: sent $1 to the browser"
fi
