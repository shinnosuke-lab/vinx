#!/bin/sh
# fetch -- HTTP through the hosting page's browser fetch(), zero setup.
#
# curl(1) needs a relay network to reach the internet; this does not, but it
# obeys the browser's rules instead: cross-origin responses are readable only
# when the server allows CORS. That covers a useful world -- public APIs,
# same-origin assets, and CORS-friendly readers (https://r.jina.ai/<URL>
# fetches arbitrary pages as text) -- and fails honestly on the rest.
#
# curl-shaped where it counts: body to stdout, -o for a file, -i to include
# the status line and headers, non-2xx exits 22 (like curl -f), transport
# failure exits 7. Rides the control plane: `rpc call http.fetch` through
# rpcd on /dev/ttyS3 (see rpc(1) and system-v2 §6). Request bodies past a
# frame go up as a /data ref ({bodyRef}); big response bodies come back the
# same way -- exact bytes over 9p, no UART crawl, no truncation.

usage() {
	cat >&2 <<'EOF'
usage: fetch [-X METHOD] [-H 'Name: value']... [-d BODY | -d @FILE]
             [-o FILE] [-i] [-t SECS] URL

Runs the request in the HOSTING BROWSER PAGE: no relay needed, but
cross-origin reads need the server to send CORS headers. For arbitrary
hosts use `curl` on a relay network, or fetch https://r.jina.ai/<URL>.
Bodies larger than 2 MB are truncated (and say so). Exit: 0 on 2xx,
22 on other statuses, 7 when the request never got an answer.
EOF
	exit 2
}

method=
hdrs='{}'
body=
have_body=
out=
include=
tmo=30
url=
while [ $# -gt 0 ]; do
	case "$1" in
		-X) [ $# -ge 2 ] || usage; method=$2; shift 2 ;;
		-H)
			[ $# -ge 2 ] || usage
			k=${2%%:*}
			v=${2#*:}
			v=${v# }
			hdrs=$(printf '%s' "$hdrs" | jq -c --arg k "$k" --arg v "$v" '. + {($k): $v}')
			shift 2 ;;
		-d) [ $# -ge 2 ] || usage; body=$2; have_body=1; shift 2 ;;
		-o) [ $# -ge 2 ] || usage; out=$2; shift 2 ;;
		-i) include=1; shift ;;
		-t) [ $# -ge 2 ] || usage; tmo=$2; shift 2 ;;
		-h|--help) usage ;;
		-*) usage ;;
		*) [ -n "$url" ] && usage; url=$1; shift ;;
	esac
done
[ -n "$url" ] || usage
case "$tmo" in ''|*[!0-9]*) tmo=30 ;; esac
[ "$tmo" -gt 120 ] && tmo=120
[ "$tmo" -lt 1 ] && tmo=1

# A small body inlines as base64 (exact bytes, no JSON-in-shell quoting
# traps, `-d @file` can carry binary). A body past what a 4 KiB frame can
# hold is staged raw under /data/.vinx/tmp and sent as {bodyRef} (§6.8).
# POST is implied by -d, as curl does it.
body_json='{}'
staged=
if [ -n "$have_body" ]; then
	src=
	case "$body" in
		@*)
			src=${body#@}
			[ -f "$src" ] || { echo "fetch: $src: no such file" >&2; exit 1; }
			;;
	esac
	if [ -n "$src" ]; then size=$(wc -c < "$src"); else size=${#body}; fi
	if [ "$size" -gt 2000 ]; then
		if ! grep -q ' /data 9p ' /proc/mounts; then
			echo 'fetch: the body is too large for the wire and no /data mount can relay it' >&2
			exit 1
		fi
		mkdir -p /data/.vinx/tmp || exit 1
		staged="/data/.vinx/tmp/body-$$-$(date +%s).bin"
		if [ -n "$src" ]; then cp -- "$src" "$staged" || exit 1
		else printf '%s' "$body" > "$staged" || exit 1; fi
		body_json=$(jq -cn --arg path "$staged" --argjson size "$(wc -c < "$staged")" \
			'{bodyRef: {path: $path, size: $size}}')
	else
		if [ -n "$src" ]; then b64=$(base64 "$src" | tr -d '\n')
		else b64=$(printf '%s' "$body" | base64 | tr -d '\n'); fi
		body_json=$(jq -cn --arg b "$b64" '{bodyB64: $b}')
	fi
	[ -n "$method" ] || method=POST
fi
[ -n "$method" ] || method=GET

payload=$(jq -cn \
	--arg url "$url" --arg method "$method" --argjson headers "$hdrs" \
	--argjson body "$body_json" --argjson t $((tmo * 1000)) \
	'{url: $url, method: $method, headers: $headers, timeoutMs: $t} + $body')
reply=$(printf '%s' "$payload" | rpc call http.fetch - -t $((tmo + 10)))
rc=$?
[ -n "$staged" ] && rm -f "$staged"
[ "$rc" -eq 0 ] || exit 7

if [ "$(printf '%s' "$reply" | jq -r '.ok')" != "true" ]; then
	echo "fetch: $(printf '%s' "$reply" | jq -r '.error // "failed"')" >&2
	exit 7
fi

status=$(printf '%s' "$reply" | jq -r '.status')
if [ -n "$include" ]; then
	printf 'HTTP %s %s\n' "$status" "$(printf '%s' "$reply" | jq -r '.statusText // ""')"
	printf '%s' "$reply" | jq -r '.headers | to_entries[] | "\(.key): \(.value)"'
	echo
fi

# The body, wherever it is: a /data ref (consumed here), inline base64, or
# inline text.
emit_body() {
	_fb_ref=$(printf '%s' "$reply" | jq -r '.bodyRef.path // empty')
	if [ -n "$_fb_ref" ]; then
		cat "$_fb_ref"
		rm -f "$_fb_ref"
		return
	fi
	_fb_b64=$(printf '%s' "$reply" | jq -r '.bodyB64 // empty')
	if [ -n "$_fb_b64" ]; then
		printf '%s' "$_fb_b64" | base64 -d
		return
	fi
	printf '%s' "$reply" | jq -rj '.body // empty'
}

if [ -n "$out" ]; then
	emit_body > "$out"
	sz=$(wc -c < "$out")
	echo "fetch: HTTP $status, $sz bytes -> $out" >&2
else
	emit_body
fi
[ "$(printf '%s' "$reply" | jq -r '.truncated // empty')" = "true" ] \
	&& echo "fetch: body truncated at 2 MB" >&2

case "$status" in
	2*) exit 0 ;;
	*) echo "fetch: HTTP $status" >&2; exit 22 ;;
esac
