#!/bin/sh
# camera snap [NAME] -- one frame from the machine's webcam, into /data.
#
# One control-plane call (media.camera.capture): the page asks getUserMedia
# for a frame (the browser shows its camera prompt), PNG-encodes it, drops
# it in /data and answers with the file's path and size -- no polling. The
# deadline is generous because the first use includes a human clicking
# "Allow".

usage() { echo 'usage: camera snap [NAME.png]' >&2; exit 2; }

[ "$1" = snap ] || usage
[ $# -le 2 ] || usage
NAME=${2:-shot-$(date +%H%M%S).png}
case "$NAME" in
	*/* | .* | '')
		echo 'camera: NAME must be a bare filename (it lands in /data)' >&2
		exit 2
		;;
esac

echo 'camera: asking the browser for a frame (first use pops the permission prompt)...'
res=$(jq -cn --arg name "$NAME" '{name: $name}' | rpc call media.camera.capture - -t 60) || exit 1
echo "camera: /data/$NAME ($(printf '%s' "$res" | jq -r '.image.size') bytes)"
