#!/bin/sh
# camera snap [NAME] -- one frame from the machine's webcam, into /data.
#
# The request goes out over the private OSC; the page asks getUserMedia for a
# frame (the browser shows its camera prompt), PNG-encodes it and drops it in
# /data, where this script is waiting for it. The wait is generous because
# the first use includes a human clicking "Allow".
. /usr/lib/vinx.sh

usage() { echo 'usage: camera snap [NAME.png]' >&2; exit 2; }

[ "$1" = snap ] || usage
[ $# -le 2 ] || usage
NAME=${2:-shot-$(date +%H%M%S).png}
case "$NAME" in
	*/* | .* | '')
		echo 'camera: NAME must be a bare filename (it lands in /data)' >&2
		exit 2
		;;
esac

printf '\033]7770;camera;%s\a\n' "$(vm_b64s "$NAME")"
echo "camera: asked the browser for a frame; waiting for /data/$NAME"

i=0
while [ "$i" -lt 30 ]; do
	if [ -s "/data/$NAME" ]; then
		echo "camera: /data/$NAME ($(wc -c < "/data/$NAME") bytes)"
		exit 0
	fi
	sleep 1
	i=$((i + 1))
done
echo 'camera: no frame arrived -- permission denied, or no camera?' >&2
exit 1
