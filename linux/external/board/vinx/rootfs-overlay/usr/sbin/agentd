#!/bin/sh
# The page's command channel, on ttyS1 (inittab wires this process's stdin,
# stdout and stderr to it).
#
# Line protocol, one request at a time -- the page serialises calls:
#
#   ->  RUN <id> <timeout_s> <len> <base64(command)>
#   <-  DONE <id> <exit_code> <base64(output)>
#
# <len> is the character count of the base64 payload, and it is what turns a
# silent truncation into a diagnosis: a very long RUN line that loses its tail
# somewhere down the serial path used to decode cleanly whenever the cut fell
# on a 4-character boundary, and the guest would run half a command without
# anyone knowing. Now the length disagrees and the reply says so. The old
# three-field form (no <len>) is still accepted, unchecked, so a cached page
# one release behind keeps working against this image.
#
# The command runs under `sh` as root; output is stdout and stderr combined,
# truncated to 64 KiB before encoding. base64 is used in both directions so
# neither side ever parses quoting: the payload may hold any byte but a
# newline. On timeout the command is SIGKILLed and the exit code is 137
# (128 + 9), which the page maps to "killed".
#
# Three things keep one request from wedging the channel or the machine:
#   - stdin is /dev/null, so a command that reads stdin (cat, grep with no
#     file, sh) cannot start eating the RUN lines that follow it on ttyS1.
#   - timeout(1) (busybox applet, enabled via board/vinx/busybox.fragment)
#     bounds the wall-clock, with no watchdog subprocess to leak or misfire.
#   - ulimit -f bounds what a runaway command (yes, cat /dev/zero) can write
#     into the RAM-backed tmpfs before the whole VM runs out of memory.
#
# READY is announced at startup so the page can tell "booted" from "booting":
# it appears once agentd's line is open, which is after rcS -- by then the
# console on ttyS0 is up too.

stty raw -echo 2>/dev/null

# Tool commands run via `sh` here, not a login shell, so /etc/profile.d is not
# sourced — export the CA bundle so `curl https://...` verifies (mbedTLS curl
# has no compiled-in CA path). Only matters behind a wisp relay, where real
# TLS reaches out; harmless otherwise.
export CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
export SSL_CERT_DIR=/etc/ssl/certs

# Commands start in /data, like the person's console: relative paths then
# land where they persist and where both channels see them. Inherited by
# every `sh $CMD` below; each call is still free to cd elsewhere.
cd /data 2>/dev/null || cd /

CMD=/tmp/.agentd-cmd
OUT=/tmp/.agentd-out
CR=$(printf '\r')
# 512-byte blocks: 32 MiB, an order of magnitude under the 128 MiB of RAM and
# far above the 64 KiB that reaches the wire. Caps a runaway write, not real
# files a command legitimately produces.
OUT_BLOCKS=65536

echo "READY agentd"

while read -r verb id timeout len b64; do
	# Tolerate a stray CR from the other side's line discipline. POSIX sh:
	# no $'\r' here, this runs under busybox ash.
	verb=${verb%"$CR"}
	len=${len%"$CR"}
	b64=${b64%"$CR"}
	[ "$verb" = "RUN" ] || continue
	[ -n "$id" ] || continue

	case "$timeout" in
		''|*[!0-9]*) timeout=30 ;;
	esac

	# Old three-field form: what read put in $len is the payload itself.
	if [ -z "$b64" ]; then
		b64=$len
		len=
	fi
	# A non-numeric count would make the -ne below write an error onto the
	# channel itself; an unverifiable length is treated as absent instead.
	case "$len" in *[!0-9]*) len= ;; esac
	if [ -n "$len" ] && [ "${#b64}" -ne "$len" ]; then
		echo "DONE $id 125 $(printf 'agentd: payload arrived truncated (%s of %s chars) -- the command was NOT run; retry, or use write_file for long content' "${#b64}" "$len" | base64 | tr -d '\n')"
		continue
	fi

	if ! printf '%s' "$b64" | base64 -d > "$CMD" 2>/dev/null; then
		echo "DONE $id 125 $(printf 'agentd: bad base64 payload' | base64 | tr -d '\n')"
		continue
	fi

	# The subshell scopes ulimit to this one command; timeout bounds its
	# wall-clock and SIGKILLs it (exit 137) if it overruns.
	( ulimit -f "$OUT_BLOCKS"; exec timeout -s KILL "$timeout" sh "$CMD" ) \
		</dev/null > "$OUT" 2>&1
	code=$?

	echo "DONE $id $code $(head -c 65536 "$OUT" | base64 | tr -d '\n')"
done

# EOF on a serial line should not happen; init respawns us if it does.
exit 0
