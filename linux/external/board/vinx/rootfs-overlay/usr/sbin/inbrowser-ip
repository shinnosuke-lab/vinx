#!/bin/sh
# Give eth0 a stable, near-unique IPv4 on the inbrowser L2 segment
# (10.0.2.0/24). v86's inbrowser hub is layer 2 only -- no DHCP -- so without
# this two VMs sharing the segment (separate browser tabs) have no address to
# reach each other with. The host number is derived from the NIC's MAC, which
# v86 randomises per instance, so separate tabs almost never collide.
#
# Added on every boot regardless of backend: in fetch/wisp modes udhcpc also
# assigns a 192.168.x address and a default route, and this extra 10.0.2.x
# alias is harmless there.
mac=$(cat /sys/class/net/eth0/address 2>/dev/null) || exit 0
[ -n "$mac" ] || exit 0
o5=0x$(echo "$mac" | cut -d: -f5)
o6=0x$(echo "$mac" | cut -d: -f6)
host=$(( (o5 * 251 + o6) % 253 + 2 ))
ip link set eth0 up 2>/dev/null
ip addr add "10.0.2.$host/24" dev eth0 2>/dev/null
echo "$host" > /run/inbrowser-host 2>/dev/null || true
