evdev: clamp the relative accumulator at the display edges

_evdev_read() accumulates EV_REL deltas without bounds and only the
*reported* point is clamped (in _evdev_calibrate). A relative mouse
swept past the display edge keeps banking invisible distance, which the
user then has to sweep back through before the cursor moves again --
felt as a growing offset between hand and cursor. Clamp the accumulator
itself on the REL path (ABS devices keep raw units for calibration), so
edge contact re-anchors the position, the way every desktop OS behaves.

Upstream: https://github.com/lvgl/lvgl/blob/v9.3.0/src/drivers/evdev/lv_evdev.c

--- a/src/drivers/evdev/lv_evdev.c
+++ b/src/drivers/evdev/lv_evdev.c
@@ -157,8 +157,17 @@
     ssize_t br;
     while((br = read(dsc->fd, &in, sizeof(in))) > 0) {
         if(in.type == EV_REL) {
-            if(in.code == REL_X) dsc->root_x += in.value;
-            else if(in.code == REL_Y) dsc->root_y += in.value;
+            /*Clamp the accumulator, not just the reported point: a relative
+             *mouse swept past the display edge must not bank invisible
+             *distance it later has to travel back through -- edge contact
+             *re-anchors the position instead, like every desktop OS.*/
+            lv_display_t * disp = lv_indev_get_display(indev);
+            if(in.code == REL_X)
+                dsc->root_x = LV_CLAMP(disp->offset_x, dsc->root_x + in.value,
+                                       disp->offset_x + disp->hor_res - 1);
+            else if(in.code == REL_Y)
+                dsc->root_y = LV_CLAMP(disp->offset_y, dsc->root_y + in.value,
+                                       disp->offset_y + disp->ver_res - 1);
         }
         else if(in.type == EV_ABS) {
             if(in.code == ABS_X || in.code == ABS_MT_POSITION_X) dsc->root_x = in.value;
